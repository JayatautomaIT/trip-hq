# ---- Copy this file to .env.local for local dev, and set the same vars in Vercel ----

# Neon Postgres connection string (from the Neon dashboard -> Connection Details -> "Pooled" URL).
# Looks like: postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# A long random string that signs login cookies. Generate one, e.g. run:  openssl rand -hex 32
SESSION_SECRET=

# The secret admin passcode ONLY YOU know. Unlocks editing finances, schedule, and pins.
# Make it something not guessable (not your name).
ADMIN_PASSCODE=

# For file/photo uploads (Files page). Vercel adds this automatically when you
# create a Blob store in your project (Storage -> Create -> Blob). For LOCAL dev,
# run `vercel env pull` to fetch it, or paste it here.
BLOB_READ_WRITE_TOKEN=
